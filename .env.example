# MODUS-Intel provider API keys.
# Copy this file to .env (which is gitignored) and fill in your keys.
# A provider with no key is skipped and the CLI warns you at startup.

# VirusTotal: https://www.virustotal.com/gui/my-apikey
# Free tier: 4 requests/minute. Lower --concurrency for large batches.
VT_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# URLHaus (abuse.ch): https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
